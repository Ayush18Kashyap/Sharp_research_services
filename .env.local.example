# Copy this file to .env.local and fill in your Supabase project's values
# (Dashboard → Project Settings → API).

SUPABASE_URL=

# The "service_role" secret key — NOT the "anon public" key.
# This bypasses row-level security, so it must stay server-side only.
# Never prefix it with NEXT_PUBLIC_, never commit it, never log it.
SUPABASE_SERVICE_ROLE_KEY=
